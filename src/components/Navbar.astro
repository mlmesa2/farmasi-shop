---
const links = [
  { name: 'Inicio', href: '/' },
  { name: 'Productos', href: '/productos' },
  { name: 'Asesoría', href: '/asesoria' },
  { name: 'Blog', href: '/blog' },
  { name: 'Sobre Mí', href: '/sobre-mi' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="fixed w-full top-0 z-50 bg-white/80 dark:bg-[#1b1c1a]/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="text-2xl font-serif font-bold text-brand-primary">FantasiShop</a>

    <nav class="hidden md:flex items-center space-x-1">
      {links.map(link => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class={`relative px-4 py-2 text-sm font-medium rounded-full transition-all duration-200 ${
              active
                ? 'text-brand-primary bg-brand-primary/10 dark:bg-brand-primary/20'
                : 'text-[#1b1c1a] dark:text-[#fbf9f5] hover:text-brand-primary hover:bg-brand-primary/5 dark:hover:bg-white/5'
            }`}
          >
            {link.name}
            {active && (
              <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-brand-primary" />
            )}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="p-2 rounded-full text-[#1b1c1a] dark:text-[#fbf9f5] hover:bg-brand-primary/10 dark:hover:bg-white/10 transition-colors"
      >
        <!-- Luna: se muestra en modo claro para indicar "cambiar a oscuro" -->
        <svg id="theme-toggle-dark-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
        <!-- Sol: se muestra en modo oscuro para indicar "cambiar a claro" -->
        <svg id="theme-toggle-light-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/>
        </svg>
      </button>

      <button class="md:hidden p-2 text-[#1b1c1a] dark:text-[#fbf9f5]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const darkIcon = document.getElementById('theme-toggle-dark-icon');
  const lightIcon = document.getElementById('theme-toggle-light-icon');

  function syncIcon() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      darkIcon?.classList.add('hidden');
      lightIcon?.classList.remove('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
      lightIcon?.classList.add('hidden');
    }
  }

  // Sincronizar al cargar (el tema ya fue aplicado por el script anti-FOUC en <head>)
  syncIcon();

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', !isDark);
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
    syncIcon();
  });
</script>
