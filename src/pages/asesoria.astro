---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_CONFIG } from "../constants/config";
import WhatsAppButton from "../components/WhatsAppButton.astro";
---

<Layout title="Únete a mi Equipo | Asesoría Farmasi">
  <Navbar />

  <main class="flex-grow pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span
            class="inline-block px-4 py-1.5 bg-brand-accent/20 text-brand-primary dark:text-brand-accent font-bold uppercase tracking-wider rounded-full mb-6"
          >
            Oportunidad de Negocio
          </span>
          <h1
            class="text-4xl md:text-6xl font-bold mb-6 text-[#1b1c1a] dark:text-[#fbf9f5]"
          >
            Emprende con Farmasi y cambia tu vida
          </h1>
          <p
            class="text-lg text-[#1b1c1a]/80 dark:text-[#fbf9f5]/80 mb-8 font-light"
          >
            Si buscas independencia financiera, flexibilidad de horarios y
            formar parte de una comunidad apasionada por la belleza, Farmasi es
            para ti. Yo te guiaré paso a paso.
          </p>

          <ul class="space-y-6 mb-10">
            {
              [
                "Márgenes de ganancia superiores al estándar de la industria (hasta 50%).",
                "Productos europeos de calidad premium, veganos y libres de crueldad.",
                "Bonos por formación de equipo y bonos de coche.",
                "Sin compras mínimas obligatorias mensuales.",
              ].map((benefit) => (
                <li class="flex items-start">
                  <div class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-primary flex items-center justify-center text-white mt-1 mr-4 shadow-sm shadow-brand-primary/30">
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  <p class="font-medium text-[#1b1c1a] dark:text-[#fbf9f5]">
                    {benefit}
                  </p>
                </li>
              ))
            }
          </ul>

          <a
            href=`https://wa.me/${SITE_CONFIG.contact.whatsappRaw}?text=Hola,%20me%20interesa%20iniciar%20mi%20negocio%20con%20Farmasi!`
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-brand-primary text-white rounded-full font-bold shadow-md shadow-brand-primary/20 hover:bg-[#b8707a] hover:shadow-lg transition-all duration-300"
          >
            Quiero más información
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
            >
          </a>
        </div>

        <div class="relative">
          <div
            class="aspect-square rounded-2xl overflow-hidden shadow-2xl relative z-10 bg-gray-100 dark:bg-gray-800"
          >
            <img
              src="https://images.unsplash.com/photo-1515378791036-0648a3ef77b2?auto=format&fit=crop&q=80&w=1200"
              alt="Asesoría Farmasi"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Decorative elements -->
          <div
            class="absolute -top-8 -right-8 w-64 h-64 bg-brand-accent/20 rounded-full blur-3xl z-0 pointer-events-none"
          >
          </div>
          <div
            class="absolute -bottom-8 -left-8 w-48 h-48 bg-brand-primary/20 rounded-full blur-3xl z-0 pointer-events-none"
          >
          </div>
        </div>
      </div>
    </div>
  </main>

  <WhatsAppButton />
  <Footer />
</Layout>
