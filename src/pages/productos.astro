---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SupabaseProductRepository } from '../data/repositories/ProductRepository';
import { GetActiveProductsUseCase } from '../domain/usecases/GetActiveProductsUseCase';

const productRepository = new SupabaseProductRepository();
const getActiveProducts = new GetActiveProductsUseCase(productRepository);
const allProducts = await getActiveProducts.execute();

const categories = ['Todos', ...new Set(allProducts.map(p => p.category))];
---

<Layout title="Catálogo de Productos">
  <Navbar />
  
  <main class="flex-grow pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">Nuestros Productos</h1>
        <p class="text-lg text-[#1b1c1a]/70 dark:text-brand-bg/70">
          Descubre la calidad europea de Farmasi. Cosméticos de alta gama, cuidado de la piel dermatológicamente probado y mucho más.
        </p>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap justify-center gap-4 mb-16" id="filter-buttons">
        {categories.map((cat, idx) => (
          <button 
            data-filter={cat}
            class={`filter-btn px-6 py-2 rounded-full font-bold text-sm transition-colors ${idx === 0 ? 'active bg-[#1b1c1a] text-brand-bg dark:bg-brand-bg dark:text-[#1b1c1a]' : 'bg-white dark:bg-[#252624] hover:bg-brand-primary hover:text-white'}`}
          >
            {cat}
          </button>
        ))}
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
        {allProducts.map(product => (
          <div class="product-item" data-category={product.category}>
            <ProductCard {...product} />
          </div>
        ))}
      </div>
    </div>
  </main>

  <WhatsAppButton />
  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const products = document.querySelectorAll('.product-item');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');
      
      // Update active state
      buttons.forEach(btn => {
        btn.classList.remove('active', 'bg-[#1b1c1a]', 'text-brand-bg', 'dark:bg-brand-bg', 'dark:text-[#1b1c1a]');
        btn.classList.add('bg-white', 'dark:bg-[#252624]');
      });
      
      button.classList.add('active', 'bg-[#1b1c1a]', 'text-brand-bg', 'dark:bg-brand-bg', 'dark:text-[#1b1c1a]');
      button.classList.remove('bg-white', 'dark:bg-[#252624]');

      // Filter products
      products.forEach(product => {
        const category = product.getAttribute('data-category');
        if (filter === 'Todos' || filter === category) {
          (product as HTMLElement).style.display = 'block';
          setTimeout(() => {
            (product as HTMLElement).style.opacity = '1';
            (product as HTMLElement).style.transform = 'translateY(0)';
          }, 10);
        } else {
          (product as HTMLElement).style.opacity = '0';
          (product as HTMLElement).style.transform = 'translateY(20px)';
          setTimeout(() => {
            (product as HTMLElement).style.display = 'none';
          }, 300);
        }
      });
    });
  });
</script>

<style>
  .product-item {
    transition: all 0.3s ease-in-out;
  }
</style>
