---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { SITE_CONFIG } from '../../constants/config';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title={`Blog de Belleza | ${SITE_CONFIG.name}`}>
  <Navbar />
  
  <main class="flex-grow pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">Blog de Belleza</h1>
        <p class="text-lg text-[#1b1c1a]/70 dark:text-brand-bg/70">
          Consejos, rutinas de cuidado de la piel y mi experiencia personal usando los mejores productos de Farmasi.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="block group">
            <div class="bg-white dark:bg-[#252624] rounded-md overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(27,28,26,0.06)] dark:hover:shadow-[0_20px_40px_rgba(0,0,0,0.5)]">
              {post.data.image && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img 
                    src={post.data.image} 
                    alt={post.data.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                </div>
              )}
              <div class="p-6">
                <span class="text-xs font-bold text-brand-primary uppercase tracking-wider mb-2 block">
                  {post.data.publishDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
                <h3 class="font-serif text-xl mb-3 text-[#1b1c1a] dark:text-brand-bg group-hover:text-brand-primary transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="text-sm opacity-80 line-clamp-3">
                  {post.data.description}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
